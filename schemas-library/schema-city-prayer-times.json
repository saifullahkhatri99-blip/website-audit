{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://globalsalah.com/#organization",
      "name": "Global Salah",
      "url": "https://globalsalah.com/",
      "description": "Global Salah provides prayer times, Salah timetables, Islamic dates and prayer-related resources for cities and countries worldwide.",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://globalsalah.com/#logo",
        "url": "https://globalsalah.com/assets/images/global-salah-full-logo.png",
        "contentUrl": "https://globalsalah.com/assets/images/global-salah-full-logo.png",
        "width": 720,
        "height": 180
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://globalsalah.com/#website",
      "url": "https://globalsalah.com/",
      "name": "Global Salah",
      "publisher": {
        "@id": "https://globalsalah.com/#organization"
      },
      "inLanguage": [
        "en",
        "ar",
        "de",
        "es",
        "fr",
        "pt",
        "ru",
        "tr",
        "ur",
        "zh-CN"
      ]
    },
    {
      "@type": "Place",
      "@id": "{{PLACE_ENTITY_ID}}",
      "name": "{{CITY_NAME}}",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{CITY_NAME}}",
        "addressRegion": "{{REGION_NAME}}",
        "addressCountry": "{{COUNTRY_CODE}}"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{LATITUDE}},
        "longitude": {{LONGITUDE}}
      },
      "containedInPlace": {
        "@type": "Country",
        "name": "{{COUNTRY_NAME}}"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Time Zone",
          "value": "{{TIMEZONE}}"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "{{PAGE_URL}}#webpage",
      "url": "{{PAGE_URL}}",
      "name": "{{META_TITLE}}",
      "description": "{{META_DESCRIPTION}}",
      "inLanguage": "{{CURRENT_LANGUAGE}}",
      "isPartOf": {
        "@id": "https://globalsalah.com/#website"
      },
      "publisher": {
        "@id": "https://globalsalah.com/#organization"
      },
      "about": {
        "@id": "{{PLACE_ENTITY_ID}}"
      },
      "contentLocation": {
        "@id": "{{PLACE_ENTITY_ID}}"
      },
      "breadcrumb": {
        "@id": "{{PAGE_URL}}#breadcrumb"
      },
      "mainEntity": [
        {
          "@id": "{{PAGE_URL}}#today-prayer-times"
        },
        {
          "@id": "{{PAGE_URL}}#monthly-prayer-times"
        }
      ],
      "isAccessibleForFree": true
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{PAGE_URL}}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "{{HOME_LABEL}}",
          "item": "{{HOME_URL}}"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{COUNTRIES_LABEL}}",
          "item": "{{COUNTRIES_URL}}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{COUNTRY_NAME}}",
          "item": "{{COUNTRY_URL}}"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "{{CITY_NAME}}",
          "item": "{{PAGE_URL}}"
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "{{PAGE_URL}}#today-prayer-times",
      "name": "Prayer Times in {{CITY_NAME}}, {{COUNTRY_NAME}} for {{GREGORIAN_DATE_DISPLAY}}",
      "description": "Today's calculated Fajr, Sunrise, Dhuhr, Asr, Maghrib and Isha times for {{CITY_NAME}}, {{COUNTRY_NAME}} on {{GREGORIAN_DATE_DISPLAY}}. Hijri date: {{HIJRI_DATE_DISPLAY}}. Time zone: {{TIMEZONE}}. Calculation method: {{CALCULATION_METHOD}}.",
      "url": "{{PAGE_URL}}",
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": 6,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Fajr",
          "item": {
            "@type": "PropertyValue",
            "name": "Fajr Prayer Time",
            "value": "{{FAJR_TIME}}"
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Sunrise",
          "item": {
            "@type": "PropertyValue",
            "name": "Sunrise Time",
            "value": "{{SUNRISE_TIME}}"
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Dhuhr",
          "item": {
            "@type": "PropertyValue",
            "name": "Dhuhr Prayer Time",
            "value": "{{DHUHR_TIME}}"
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Asr",
          "item": {
            "@type": "PropertyValue",
            "name": "Asr Prayer Time",
            "value": "{{ASR_TIME}}"
          }
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Maghrib",
          "item": {
            "@type": "PropertyValue",
            "name": "Maghrib Prayer Time",
            "value": "{{MAGHRIB_TIME}}"
          }
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Isha",
          "item": {
            "@type": "PropertyValue",
            "name": "Isha Prayer Time",
            "value": "{{ISHA_TIME}}"
          }
        }
      ]
    },
    {
      "@type": "Dataset",
      "@id": "{{PAGE_URL}}#monthly-prayer-times",
      "name": "{{CITY_NAME}} Prayer Times - {{MONTH_NAME}} {{YEAR}}",
      "alternateName": "{{CITY_NAME}} Monthly Salah Timetable - {{MONTH_NAME}} {{YEAR}}",
      "description": "Daily Fajr, Sunrise, Dhuhr, Asr, Maghrib and Isha prayer times for {{CITY_NAME}}, {{COUNTRY_NAME}} during {{MONTH_NAME}} {{YEAR}}, calculated for coordinates {{LATITUDE}}, {{LONGITUDE}} in the {{TIMEZONE}} time zone using {{CALCULATION_METHOD}} and {{ASR_METHOD}} Asr calculation.",
      "url": "{{PAGE_URL}}",
      "inLanguage": "{{CURRENT_LANGUAGE}}",
      "creator": {
        "@id": "https://globalsalah.com/#organization"
      },
      "publisher": {
        "@id": "https://globalsalah.com/#organization"
      },
      "about": {
        "@id": "{{PLACE_ENTITY_ID}}"
      },
      "spatialCoverage": {
        "@id": "{{PLACE_ENTITY_ID}}"
      },
      "temporalCoverage": "{{MONTH_START_ISO}}/{{MONTH_END_ISO}}",
      "version": "{{YEAR}}-{{MONTH_NUMBER}}",
      "isAccessibleForFree": true,
      "measurementTechnique": "{{CALCULATION_METHOD}} prayer time calculation method with {{ASR_METHOD}} Asr calculation. Prayer times are calculated using the geographic coordinates of {{CITY_NAME}}, {{COUNTRY_NAME}} and the {{TIMEZONE}} time zone.",
      "variableMeasured": [
        {
          "@type": "PropertyValue",
          "name": "Fajr prayer time",
          "description": "Daily calculated Fajr prayer beginning time"
        },
        {
          "@type": "PropertyValue",
          "name": "Sunrise time",
          "description": "Daily calculated local sunrise time"
        },
        {
          "@type": "PropertyValue",
          "name": "Dhuhr prayer time",
          "description": "Daily calculated Dhuhr prayer beginning time"
        },
        {
          "@type": "PropertyValue",
          "name": "Asr prayer time",
          "description": "Daily calculated Asr prayer beginning time using {{ASR_METHOD}} calculation"
        },
        {
          "@type": "PropertyValue",
          "name": "Maghrib prayer time",
          "description": "Daily calculated Maghrib prayer beginning time"
        },
        {
          "@type": "PropertyValue",
          "name": "Isha prayer time",
          "description": "Daily calculated Isha prayer beginning time"
        }
      ],
      "keywords": [
        "{{CITY_NAME}} prayer times",
        "{{CITY_NAME}} Salah times",
        "{{CITY_NAME}} prayer timetable",
        "{{CITY_NAME}} namaz times"
      ],
      "distribution": [
        {
          "@type": "DataDownload",
          "@id": "{{PDF_URL}}#download",
          "name": "{{CITY_NAME}} Prayer Times - {{MONTH_NAME}} {{YEAR}} PDF",
          "description": "Printable monthly prayer timetable PDF containing Fajr, Sunrise, Dhuhr, Asr, Maghrib and Isha times for {{CITY_NAME}}, {{COUNTRY_NAME}} for {{MONTH_NAME}} {{YEAR}}.",
          "encodingFormat": "application/pdf",
          "contentUrl": "{{PDF_URL}}",
          "inLanguage": "{{CURRENT_LANGUAGE}}",
          "isAccessibleForFree": true
        }
      ]
    }
  ]
}
