# ==============================================================================
# GLOBAL SALAH — PRODUCTION LITESPEED / APACHE CONFIGURATION (.htaccess)
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Enforce HTTPS (Redirect HTTP -> HTTPS)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Enforce Non-WWW (Redirect www.globalsalah.com -> globalsalah.com)
    RewriteCond %{HTTP_HOST} ^www\.globalsalah\.com$ [NC]
    RewriteRule ^(.*)$ https://globalsalah.com/$1 [L,R=301]

    # 3. 301 Redirects for Legacy / Common Aliases
    RewriteRule ^about/?$ /about-us/ [R=301,L]
    RewriteRule ^contact/?$ /contact-us/ [R=301,L]
    RewriteRule ^terms-of-service/?$ /terms-and-conditions/ [R=301,L]
    RewriteRule ^terms/?$ /terms-and-conditions/ [R=301,L]
    RewriteRule ^qibla/?$ /qibla-finder/ [R=301,L]
    RewriteRule ^qibla-direction/?$ /qibla-finder/ [R=301,L]
    RewriteRule ^countries/saudi-arabia/makkah/?$ /countries/saudi-arabia/mecca/ [R=301,L]
    RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
    RewriteRule ^sitemap-index\.xml$ /sitemap.xml [R=301,L]

    # 4. Trailing Slash Enforcement (for SEO canonicalization)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
    RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ==============================================================================
# SECURITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    # Enforce HTTPS HSTS (1 Year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent MIME-Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Anti-Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Browser Permissions Policy
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=()"

    # Cross-Origin Opener Policy
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Content Security Policy (Adjust domains if adding analytics like GA4 / Clarity)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://www.google-analytics.com;"
</IfModule>

# ==============================================================================
# BROWSER CACHING & STATIC ASSET EXPIRATION
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Dynamic HTML (Always Revalidate)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript (1 Year Immutable)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Media & Images (1 Year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ==============================================================================
# GZIP & BROTLI COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
